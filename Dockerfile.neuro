# Builds only the authenticated Python/C++ research backend.
# The TanStack frontend is deployed separately to its existing web host.
FROM python:3.12-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY native/neurophysics.cpp /work/neurophysics.cpp
RUN g++ -O2 -std=c++17 -Wall -Wextra /work/neurophysics.cpp -o /work/neurophysics

FROM python:3.12-slim
RUN useradd --create-home --uid 10001 lab && mkdir -p /app/bin /app/services /app/python
WORKDIR /app
COPY --from=build /work/neurophysics /app/bin/neurophysics
COPY services/neuro_service.py /app/services/neuro_service.py
RUN chown -R lab:lab /app
USER lab
ENV PYTHONPATH=/app/python NEUROPHYSICS_BIN=/app/bin/neurophysics NEURO_SERVICE_HOST=0.0.0.0 NEURO_SERVICE_PORT=8081
EXPOSE 8081
# Requires a strong NEURO_SERVICE_TOKEN supplied by your hosting platform.
CMD ["python3", "/app/services/neuro_service.py"]
